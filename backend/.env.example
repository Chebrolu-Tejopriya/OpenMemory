# Server Port
PORT=3001

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: OpenAI API Key (for alternative embeddings)
OPENAI_API_KEY=your-openai-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# MCP endpoint (POST /mcp). Long random secret; the endpoint stays disabled while unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=your-mcp-token
# Password for the MCP sign-in page, used by apps that connect with OAuth (Claude web/desktop/mobile).
# OAuth stays off while unset. Changing it signs every connected app out.
MCP_OAUTH_PASSWORD=your-long-password
# Public URL of this backend. Only needed off Render or behind a custom domain.
# MCP_PUBLIC_URL=https://mcp.example.com

# Environment
NODE_ENV=production
